{
  "name": "zen-bookmarks",
  "version": "0.2.0",
  "description": "Read and manage Zen browser sidebar bookmarks, folders, and workspaces from a safe command-line interface.",
  "type": "module",
  "bin": {
    "zen-bookmarks": "./zen-bookmarks.ts",
    "zen-bookmarks-export": "./extract-bookmarks.ts",
    "zen-bookmarks-update": "./update-bookmarks.ts"
  },
  "scripts": {
    "start": "bun zen-bookmarks.ts",
    "export": "bun zen-bookmarks.ts export",
    "update": "bun update-bookmarks.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "zen",
    "zen-browser",
    "bookmarks",
    "firefox",
    "jsonlz4",
    "mozlz4",
    "session",
    "sidebar",
    "export"
  ],
  "author": "Wyatt Johnson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyattjoh/zen-bookmarks.git"
  },
  "homepage": "https://github.com/wyattjoh/zen-bookmarks#readme",
  "bugs": {
    "url": "https://github.com/wyattjoh/zen-bookmarks/issues"
  },
  "files": [
    "zen-bookmarks.ts",
    "cli.ts",
    "credential-store.ts",
    "bookmark-candidates.ts",
    "bm25.ts",
    "link-index.ts",
    "search-cache.ts",
    "typesafe-search.ts",
    "exporters.ts",
    "session-store.ts",
    "sidebar.ts",
    "zen-process.ts",
    "extract-bookmarks.ts",
    "update-bookmarks.ts",
    "mozlz4.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
